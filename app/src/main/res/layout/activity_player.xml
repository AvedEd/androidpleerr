<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:resize_mode="fit" />

    <!-- Transparent overlay that owns gestures: double-tap seek (left/right),
         vertical swipe for brightness (left half) / volume (right half).
         Plain taps are forwarded to playerView underneath so its native
         play/pause + seek bar controller keeps working. -->
    <View
        android:id="@+id/gestureOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Brightness/volume level feedback while dragging -->
    <TextView
        android:id="@+id/adjustFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Seek feedback on double-tap: "-10 сек" on the left, "+10 сек" on the right -->
    <TextView
        android:id="@+id/seekFeedbackLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="32dp"
        android:background="#99000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="#4FD1C5"
        android:textSize="16sp"
        android:alpha="0" />

    <TextView
        android:id="@+id/seekFeedbackRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="32dp"
        android:background="#99000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="#4FD1C5"
        android:textSize="16sp"
        android:alpha="0" />

    <!-- Live download speed / peers overlay, top-left -->
    <FrameLayout
        android:id="@+id/statsOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp">

        <TextView
            android:id="@+id/statsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#88000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#4FD1C5"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- Bottom block: scrollable icon strip (audio/subtitle track pickers, more can be
         added later without re-laying anything out) above the episode strip. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/iconStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/audioTrackButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_icon_button"
                    android:gravity="center"
                    android:text="🔊"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/subtitleTrackButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_button"
                    android:gravity="center"
                    android:text="💬"
                    android:textSize="18sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Episode picker, only visible for multi-file torrents -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#99000000"
            android:padding="4dp"
            tools:listitem="@layout/item_episode" />
    </LinearLayout>

</FrameLayout>
